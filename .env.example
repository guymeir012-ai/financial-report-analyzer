# Copy to .env and fill in real values. Never commit .env.

# Claude API (Anthropic)
ANTHROPIC_API_KEY=
# Monthly spend cap for Claude API, in USD
CLAUDE_MONTHLY_BUDGET_USD=

# Finnhub (stock prices and news, free tier)
FINNHUB_API_KEY=

# Supabase (database and login)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEC EDGAR requires a name and contact email in every request's User-Agent
SEC_EDGAR_USER_AGENT="Your Name your-email@example.com"
